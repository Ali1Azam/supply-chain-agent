# Copy this file to .env and fill in what you have. Everything is optional --
# the project runs fully out of the box on SQLite + simulated data with none
# of these set.

# --- Database ---
# Defaults to a local SQLite file (data/supply_chain.db) if unset.
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/supply_chain
DATABASE_URL=

# --- External APIs (optional; simulated data is used if unset) ---
OPENWEATHERMAP_API_KEY=
NEWS_API_KEY=

# --- LLM for agent narration (optional; deterministic ReAct trace works without it) ---
# Set one of these to have the agent write a natural-language executive
# summary of each run. LLM_PROVIDER can be "auto", "anthropic", "openai", or "none".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto

# --- Business rules ---
SERVICE_LEVEL_Z=1.65
ORDERING_COST=50
HOLDING_COST_PCT=0.20
FORECAST_HORIZON_DAYS=30

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
